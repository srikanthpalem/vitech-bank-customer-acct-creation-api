#%RAML 1.0 DataType
properties:
          accountNum:
            required: true
            maxLength: 10
            minLength: 10
          atmPin:
            required: true
            minLength: 4
            maxLength: 4


          ifscCode:
            required: true
            minLength: 4
            maxLength: 10
          depositAmount:
            type: number
          mailId:
            required: true
            type: string
          contact:
            required: true
            type: number